{
  "name": "videogenerator-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:init": "node scripts/init-db.js",
    "migrate": "node scripts/migrate.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "short": "tsx src/cli/short.ts",
    "hooks": "tsx src/cli/hooks.ts",
    "seed": "node scripts/seed.js",
    "ollama:tunnel": "node scripts/ollama-tunnel.js",
    "check:text": "tsx src/cli/textcheck.ts",
    "flux": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../flux/start.ps1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "kokoro-js": "^1.2.1",
    "mysql2": "^3.22.5",
    "node-edge-tts": "^1.2.12",
    "nodemailer": "^10.6.1",
    "openai": "^6.45.0",
    "playwright-core": "^1.49.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
