# Copy to .env and fill in. Secrets live here only, never in the database or in git.

# Server
PORT=4501

# Database (MySQL / MariaDB)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=videogenerator

# Text (writing): Ollama is the default. Initial values only; the Settings page saves its own choice.
# Install Ollama (ollama.com), then:  ollama pull qwen3.8:27b
TEXT_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_THINK=false
OLLAMA_NUM_CTX=32768
TEXT_FALLBACK_TO_OTHER=true
# Ollama on a server instead of this PC: keep an SSH tunnel open with `npm run ollama:tunnel`, then set the address to
# http://127.0.0.1:11435 (11434 is taken when Ollama also runs here). Nothing is exposed on the server.
OLLAMA_SSH=
OLLAMA_TUNNEL_PORT=11435

# OpenAI: the standby / second choice for text, and optional for images and non-Edge speech. Not needed to run.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-2

# Video providers
# Flow A: Google Flow (Veo 3.1) runs in the browser; no key needed. Model label used in job packs:
FLOW_MODEL=Veo 3.1 - Lite
# Flow B: Veoframe (browser). Set to true once the account is active.
VEOFRAME_ENABLED=false
VEOFRAME_PROFILE_DIR=
# API fallbacks
HIGGSFIELD_API_KEY=
FAL_KEY=
GEMINI_API_KEY=

# YouTube upload (create an OAuth desktop client in Google Cloud; add your Google account as a test user)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4501/api/youtube/callback

# Email notifications when a video awaits approval
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=

# Job worker
JOB_CONCURRENCY=2
JOB_POLL_MS=2000
